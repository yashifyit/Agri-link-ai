# KisanLink Environment Configuration (Template)
# Copy this file to .env and fill in the values

# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=False

# Database
DATABASE_URL=sqlite:///./kisanlink.db

# Security & Authentication
# IMPORTANT: Generate secure random keys for production (e.g., openssl rand -hex 32)
SECRET_KEY=your-secret-key-here-min-32-chars
JWT_SECRET=your-jwt-access-secret-key-min-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-key-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# CORS Allowed Origins (comma-separated URLs)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret

# Redis / Cache (Optional)
REDIS_URL=

# AI & LLM Services
GEMINI_API_KEY=your-gemini-api-key-here
AI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Mandi / Gov Data Integration
MANDI_API_URL=https://api.data.gov.in/resource/9ef84268-d588-465a-a308-a864a43d0070

# Frontend API Base URL
VITE_API_URL=http://localhost:8000/api/v1
